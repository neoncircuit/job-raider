# Job Raider Frontend - Environment Configuration
# Copy this file to .env and adjust as needed
# NOTE: This file should only contain configuration values
# For API keys and secrets, see backend-py/.env

# ========================================
# Backend API Configuration
# ========================================
# Base URL for the FastAPI backend
BACKEND_API_URL=http://localhost:8000

# ========================================
# Request Timeouts
# ========================================
# Default HTTP request timeout in seconds (LLM calls can take 30-90s)
REQUEST_TIMEOUT_SEC=120

# Job search timeout in seconds (scraping is slow)
SEARCH_TIMEOUT_SEC=120

# ========================================
# Dashboard Settings
# ========================================
# Seconds between pipeline status polls
POLLING_INTERVAL_SEC=2

# Default number of items per page in job listings
PAGE_SIZE=20

# Enable debug logging and verbose error messages
DEBUG=false
