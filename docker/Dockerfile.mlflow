FROM python:3.12-slim

LABEL maintainer="Job Raider"
LABEL description="MLflow tracking server for Job Raider experiment tracking"

RUN pip install --no-cache-dir mlflow>=2.0.0

EXPOSE 5000

VOLUME /mlflow

CMD ["mlflow", "server", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--backend-store-uri", "sqlite:///mlflow/mlflow.db", \
     "--default-artifact-root", "/mlflow/artifacts"]
