# Job Raider - Backend Dockerfile
# Multi-stage build for optimized image

FROM python:3.12-slim AS base

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Set working directory
WORKDIR /app/backend-py

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    zstd \
    && rm -rf /var/lib/apt/lists/*

# Install Ollama for local models
RUN curl -fsSL https://ollama.com/install.sh | sh

# Copy requirements first for better caching
COPY apps/backend-py/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright browsers
RUN playwright install --with-deps chromium

# Copy application code into /app/backend-py to mirror the monorepo layout
COPY apps/backend-py/ /app/backend-py/

# Create data directories
RUN mkdir -p data/{listings,cache,results,applications,metrics,experiments,logs,profiles,outputs}

# Set PYTHONPATH to the backend package root
ENV PYTHONPATH=/app/backend-py

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Default command
CMD ["python", "-m", "uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
