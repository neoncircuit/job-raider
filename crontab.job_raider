# Job Raider - Cron Job Configuration
#
# This file contains cron job configurations for automated
# job scraping and application pipeline execution.
#
# Author: Job Raider
# Date: 2026-04-21
#
# Installation:
#   crontab -l | grep -v job_raider | crontab -
#   crontab crontab.job_raider
#
# Format:
#   minute hour day month day-of-week command
#

# Environment variables
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
HOME=/home/jamestjy

# Job data directories
DATA_DIR="/mnt/d/GitHub/job-raider/data"
RESUME_PATH="$DATA_DIR/resume.pdf"
LOG_DIR="$DATA_DIR/logs"

# Ensure log directory exists
*/5 * * * * mkdir -p $LOG_DIR

# Morning job scrape (9:00 AM daily)
# Scrapes for new job postings and filters by keywords
0 9 * * * cd /mnt/d/GitHub/job-raider && source .venv/bin/activate && python main.py --resume $RESUME_PATH --keywords "python software engineer" --locations "remote" --min-score 60 >> $LOG_DIR/morning_scrape_$(date +\%Y\%m\%d).log 2>&1

# Afternoon job scrape (2:00 PM daily)
# Scrapes for new postings with different keywords
0 14 * * * cd /mnt/d/GitHub/job-raider && source .venv/bin/activate && python main.py --resume $RESUME_PATH --keywords "fintech AI machine learning" --locations "remote new york" --min-score 65 >> $LOG_DIR/afternoon_scrape_$(date +\%Y\%m\%d).log 2>&1

# Evening application submission (6:00 PM daily)
# Processes scored jobs and generates/submit resumes
0 18 * * * cd /mnt/d/GitHub/job-raider && source .venv/bin/activate && python main.py --resume $RESUME_PATH --keywords "python" --locations "remote" --start-from generate_resumes --no-dry-run >> $LOG_DIR/evening_apply_$(date +\%Y\%m\%d).log 2>&1

# Weekly metrics report (Sunday 8:00 PM)
# Generates weekly cost and outcome reports
0 20 * * 0 cd /mnt/d/GitHub/job-raider && source .venv/bin/activate && python -c "
from src.metrics import CostTracker, OutcomeTracker
import json

cost_tracker = CostTracker()
outcome_tracker = OutcomeTracker()

cost_stats = cost_tracker.get_aggregate_stats(days=7)
outcome_stats = outcome_tracker.get_pipeline_effectiveness(days=7)

report = {
    'period': '7 days',
    'cost': cost_stats,
    'outcomes': outcome_stats,
}

with open('$DATA_DIR/metrics/weekly_$(date +\%Y\%m\%d).json', 'w') as f:
    json.dump(report, f, indent=2, default=str)

print('Weekly report generated')
" >> $LOG_DIR/weekly_report_$(date +\%Y\%m\%d).log 2>&1

# Monthly data cleanup (1st of month at 3:00 AM)
# Removes old listings and cached data
0 3 1 * * cd /mnt/d/GitHub/job-raider && find $DATA_DIR/listings -name "*.json" -mtime +30 -delete && find $DATA_DIR/cache -name "*.json" -mtime +7 -delete && echo "Cleanup completed $(date)" >> $LOG_DIR/cleanup.log 2>&1

# Health check (every hour)
# Checks if services are running properly
0 * * * * cd /mnt/d/GitHub/job-raider && source .venv/bin/activate && python -c "
import sys
sys.path.insert(0, 'src')
from utils.logger import get_logger

logger = get_logger('health')
logger.info('Health check passed')
" >> $LOG_DIR/health_check.log 2>&1

# Comments for custom schedules:
#
# Run every 6 hours:
# 0 */6 * * * command
#
# Run Monday, Wednesday, Friday at 10 AM:
# 0 10 * * 1,3,5 command
#
# Run on weekdays at 8 AM and 6 PM:
# 0 8,18 * * 1-5 command
#
# Run every Sunday at midnight:
# 0 0 * * 0 command
