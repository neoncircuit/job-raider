# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for these files
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf

# Frontend sources: Prettier enforces "endOfLine": "lf" (apps/frontend-ts/.prettierrc.json)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf

# Build files: make and Docker fail on CRLF line endings
Makefile text eol=lf
Dockerfile* text eol=lf

# Binary files
*.gguf binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
