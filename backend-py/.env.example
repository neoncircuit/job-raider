# Job Raider - Backend Environment Configuration
# Copy this file to .env and fill in your credentials.
# NOTE: This file contains secrets only. All other settings live in config/*.yaml.

# ========================================
# API Security
# ========================================
# Shared secret between the frontend proxy and this backend.
# Must match API_KEY in frontend-ts/.env.local.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your_api_key_here

# ========================================
# Supabase (Database + Storage)
# ========================================
# Project Settings -> Database -> Connection string -> Transaction (port 6543)
# Change postgresql:// to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Project Settings -> Database -> Connection string -> Session (port 5432)
# Change postgresql:// to postgresql+psycopg2://
# Used only by Alembic migrations — not the running app.
DATABASE_URL_DIRECT=postgresql+psycopg2://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Project Settings -> API -> Project URL
SUPABASE_URL=https://[ref].supabase.co

# Project Settings -> API -> service_role (keep this secret)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ========================================
# LLM Providers
# ========================================
# Anthropic Claude (fallback / dev): https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama host (local: http://localhost:11434, Docker: http://ollama:11434)
OLLAMA_HOST=http://localhost:11434

# Google Gemini — pick one of the two options below:

# Option A: Google AI Studio (simple API key, free tier available)
# Get key: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your_google_api_key_here

# Option B: Vertex AI (billed to GCP project — use this for your 90-day GCP trial)
# Enable Vertex AI API in GCP console first: https://console.cloud.google.com/apis/library/aiplatform.googleapis.com
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ========================================
# Job Sources
# ========================================
# JSearch via RapidAPI — aggregates Indeed, Glassdoor, Jobstreet, 50+ boards
# Get your key: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here

# LinkedIn Easy Apply (optional — required for auto-apply feature)
# Uncomment and fill to enable automated LinkedIn Easy Apply submissions.
# Enable in config/scrapers_config.yaml -> linkedin_easy_apply.enabled: true
# LINKEDIN_EMAIL=your_linkedin_email
# LINKEDIN_PASSWORD=your_linkedin_password

# ========================================
# Kaggle (optional — for evaluation notebooks only)
# ========================================
# https://www.kaggle.com/settings -> API -> Create New Token
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# ========================================
# Observability (optional)
# ========================================
# SENTRY_DSN=your_sentry_dsn_here
# MLFLOW_TRACKING_URI=http://localhost:5000
